# Daeroom Cloud API Configuration (bikesharingdemand)
# Copy this file to .env.local and fill in your credentials from Daeroom Cloud Dashboard
DAEROOM_URL="https://apiv1.daeroom.my.id"
DAEROOM_API_KEY="daeroom_sk_live_your_api_key_here"
DAEROOM_READONLY_KEY="daeroom_rk_live_your_readonly_key_here"
NEXT_PUBLIC_S3_URL="https://s3.daeroom.my.id"
DAEROOM_S3_BUCKET="bikesharingdemand-assets"
